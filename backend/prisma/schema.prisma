generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  RENTED
  UNAVAILABLE
}

enum ViewingStatus {
  REQUESTED
  APPROVED
  RESCHEDULE_REQUESTED
  DECLINED
}

enum BookingStatus {
  PENDING
  APPROVED
  DEPOSIT_PENDING
  VERIFICATION_PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  DECLINED
  CANCELLED
  EXPIRED
}

enum DepositVerificationStatus {
  AWAITING_EVIDENCE
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum EvidenceStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum RefundStatus {
  NOT_APPLICABLE
  REFUND_PENDING
  REFUNDED
  FORFEITED
}

enum ReviewStatus {
  VISIBLE
  REPORTED
  HIDDEN
}

enum ReportTargetType {
  PROPERTY
  USER
  PARTNER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum SenderType {
  RENTER
  PARTNER
}

enum NotificationType {
  BOOKING_APPROVED
  BOOKING_DECLINED
  BOOKING_EXPIRED
  BOOKING_CANCELLED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  EVIDENCE_UPLOADED
  VIEWING_UPDATE
  NEW_MESSAGE
  REPORT_UPDATE
  PARTNER_SUSPENDED
  PARTNER_RESTORED
  PARTNER_APPLICATION_UPDATE
  LISTING_REVIEWED
}

enum AuditAction {
  PARTNER_APPLICATION_APPROVED
  PARTNER_APPLICATION_REJECTED
  PARTNER_SUSPENDED
  PARTNER_ACCESS_RESTORED
  LISTING_PUBLISHED
  LISTING_REJECTED
  LISTING_SUSPENDED
  REPORT_UNDER_REVIEW
  REPORT_RESOLVED
  REPORT_DISMISSED
  REVIEW_HIDDEN
  REVIEW_RESTORED
  BOOKING_APPROVED
  BOOKING_DECLINED
  BOOKING_EXPIRED
  EVIDENCE_VERIFIED
  EVIDENCE_REJECTED
  RENTAL_STARTED
  RENTAL_COMPLETED
  BOOKING_CANCELLED
  REFUND_RECORDED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  phone        String?
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partnerApplications  PartnerApplication[]
  properties           Property[]           @relation("PartnerProperties")
  favorites            Favorite[]
  renterConversations  Conversation[]       @relation("RenterConversations")
  partnerConversations Conversation[]       @relation("PartnerConversations")
  messages             Message[]
  viewings             Viewing[]
  bookings             Booking[]            @relation("RenterBookings")
  reviews              Review[]
  reports              Report[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  paymentInquiries     PaymentInquiry[]     @relation("RenterPaymentInquiries")
  paymentMessages      PaymentMessage[]     @relation("PaymentMessageSender")
}

model PartnerApplication {
  id                    String                   @id @default(cuid())
  userId                String
  user                  User                     @relation(fields: [userId], references: [id])
  fullName              String
  email                 String
  phone                 String
  idDocumentName        String
  idDocumentType        String
  ownershipDocumentName String
  ownershipDocumentType String
  note                  String                   @default("")
  status                PartnerApplicationStatus
  submittedAt           DateTime                 @default(now())
  reviewedAt            DateTime?
  rejectionReason       String?
  suspendedAt           DateTime?
  suspensionReason      String?
  suspendedById         String?
  unsuspendedAt         DateTime?

  @@index([userId, submittedAt])
}

model Property {
  id              String        @id @default(cuid())
  partnerUserId   String
  partner         User          @relation("PartnerProperties", fields: [partnerUserId], references: [id])
  title           String
  propertyType    String
  monthlyRent     Int
  location        String
  buildingName    String?
  fullAddress     String?
  area            String?
  province        String?
  description     String
  bedrooms        Int
  bathrooms       Int
  sizeSqm         Int
  facilities      String[]
  houseRules      Json?
  listingStatus   ListingStatus @default(DRAFT)
  roomStatus      RoomStatus    @default(AVAILABLE)
  popular         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  submittedAt     DateTime?
  reviewedAt      DateTime?
  rejectionReason String?

  photos        PropertyPhoto[]
  favorites     Favorite[]
  conversations Conversation[]
  viewings      Viewing[]
  bookings      Booking[]
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  src        String
  alt        String
  name       String
  type       String
  sortOrder  Int      @default(0)
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Conversation {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  renterUserId  String
  renter        User     @relation("RenterConversations", fields: [renterUserId], references: [id])
  partnerUserId String
  partner       User     @relation("PartnerConversations", fields: [partnerUserId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      Message[]

  @@unique([propertyId, renterUserId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  senderType     SenderType
  text           String
  createdAt      DateTime     @default(now())
  read           Boolean      @default(false)
}

model Viewing {
  id                   String        @id @default(cuid())
  propertyId           String
  property             Property      @relation(fields: [propertyId], references: [id])
  renterId             String
  renter               User          @relation(fields: [renterId], references: [id])
  viewingDate          String
  viewingTime          String
  message              String        @default("")
  status               ViewingStatus @default(REQUESTED)
  partnerSuggestedDate String?
  partnerSuggestedTime String?
  partnerMessage       String?
  declineReason        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Booking {
  id                  String        @id @default(cuid())
  propertyId          String
  property            Property      @relation(fields: [propertyId], references: [id])
  renterUserId        String
  renter              User          @relation("RenterBookings", fields: [renterUserId], references: [id])
  requestedMoveInDate String
  message             String        @default("")
  status              BookingStatus @default(PENDING)
  monthlyRent         Int
  depositAmount       Int?
  paymentDeadline     DateTime?
  approvedAt          DateTime?
  declinedAt          DateTime?
  declineReason       String?
  rentalStartedAt     DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelledById       String?
  createdAt           DateTime      @default(now())

  deposit        ReservationDeposit?
  evidence       PaymentEvidence[]
  refund         Refund?
  review         Review?
  paymentInquiry PaymentInquiry?
}

model ReservationDeposit {
  id                  String                    @id @default(cuid())
  bookingId           String                    @unique
  booking             Booking                   @relation(fields: [bookingId], references: [id])
  amount              Int
  deadline            DateTime
  verificationStatus  DepositVerificationStatus @default(AWAITING_EVIDENCE)
  paymentInstructions String
}

model PaymentEvidence {
  id              String         @id @default(cuid())
  bookingId       String
  booking         Booking        @relation(fields: [bookingId], references: [id])
  fileName        String
  fileType        String
  storedPath      String?
  note            String         @default("")
  uploadedAt      DateTime       @default(now())
  status          EvidenceStatus @default(PENDING_VERIFICATION)
  verifiedAt      DateTime?
  verifiedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
}

model Refund {
  id           String       @id @default(cuid())
  bookingId    String       @unique
  booking      Booking      @relation(fields: [bookingId], references: [id])
  status       RefundStatus
  method       String?
  amount       Int?
  refundedAt   DateTime?
  recordedAt   DateTime     @default(now())
  recordedById String
  note         String       @default("")
}

model Review {
  id            String       @id @default(cuid())
  bookingId     String       @unique
  booking       Booking      @relation(fields: [bookingId], references: [id])
  renterUserId  String
  renter        User         @relation(fields: [renterUserId], references: [id])
  rating        Int
  comment       String
  status        ReviewStatus @default(VISIBLE)
  createdAt     DateTime     @default(now())
  moderatedAt   DateTime?
  moderatedById String?
}

model Report {
  id             String           @id @default(cuid())
  reporterUserId String
  reporter       User             @relation(fields: [reporterUserId], references: [id])
  targetType     ReportTargetType
  targetId       String
  targetLabel    String
  reason         String
  description    String           @default("")
  status         ReportStatus     @default(OPEN)
  createdAt      DateTime         @default(now())
  reviewedAt     DateTime?
  resolutionNote String?
  reviewedById   String?
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  message           String
  link              String?
  relatedBookingId  String?
  relatedViewingId  String?
  relatedPropertyId String?
  relatedEvidenceId String?
  relatedReportId   String?
  createdAt         DateTime         @default(now())
  read              Boolean          @default(false)
}

model AuditLog {
  id         String      @id @default(cuid())
  timestamp  DateTime    @default(now())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  actorLabel String
  action     AuditAction
  targetType String
  targetId   String
  targetName String
  details    String
}

model PaymentInquiry {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  booking      Booking  @relation(fields: [bookingId], references: [id])
  renterUserId String
  renter       User     @relation("RenterPaymentInquiries", fields: [renterUserId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     PaymentMessage[]
}

model PaymentMessage {
  id         String         @id @default(cuid())
  inquiryId  String
  inquiry    PaymentInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User           @relation("PaymentMessageSender", fields: [senderId], references: [id])
  senderRole String
  text       String
  createdAt  DateTime       @default(now())
  read       Boolean        @default(false)
}
